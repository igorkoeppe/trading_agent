# Copie para .env e preencha. O arquivo .env nunca vai para o repositório.
#
# Este projeto roda SOMENTE em paper trading. Chaves de conta real não são lidas
# por nenhum módulo; não coloque chaves de conta real neste arquivo.

TRADING_MODE=paper

# Chaves da conta PAPER (painel da Alpaca > conta paper > API Keys)
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Endereço da API de paper. O sistema recusa iniciar com qualquer outro valor.
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Feed de dados históricos: "sip" (todas as bolsas, com restrição dos últimos
# 15 minutos no plano gratuito) ou "iex" (só a bolsa IEX).
ALPACA_DATA_FEED=sip
